{
  "name": "soundsky",
  "version": "1.3.35",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "dev": "node scripts/dev.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "npm run check && npm test && npm run package"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.10",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@paper-design/shaders": "0.0.81",
    "@paper-design/shaders-react": "0.0.81",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
